REPO=$(basename "$PWD")
# The tracked bead projection is written by the COMMIT-MSG hook, scoped to the
# beads the commit subject names (rosary-e5bfd3, ADR-0024 amendment A). It used
# to be written here, whole-store, on every commit — which is how a code-only
# commit came to carry every bead record that changed since the last one, and
# how PR #403 landed `.beads/beads.jsonl | 1115 ------` (rosary-599778): this
# hook fires in linked worktrees and jj-driven operations that never hold
# `.beads/beads.db`, and `SqliteBeadStore::connect` creates an empty store on
# demand, so a whole-store render there read 0 beads. A scoped upsert cannot
# wipe, so the magnitude guard went with the render.
#
# What stays is the shape any future pre-commit bead work must fit inside:
# opt-in by tracking, and the canonical checkout only (a linked worktree has
# git-dir != git-common-dir; the canonical checkout has them equal).
if [ ! -d ".beads/dolt/$REPO" ] && git ls-files --error-unmatch .beads/beads.jsonl >/dev/null 2>&1; then
    _gd=$(git rev-parse --git-dir 2>/dev/null)
    _gc=$(git rev-parse --git-common-dir 2>/dev/null)
    if [ -n "$_gd" ] && [ -n "$_gc" ] && [ "$_gd" != "$_gc" ]; then
        : # Skip only this managed block; continue the surrounding hook.
    else
        : # Nothing to render at pre-commit time: the message does not exist yet.
    fi
fi
