# Refuse to push when the PUSHED ref's tracked bead export is stale for the
# beads the pushed commits name (rosary-e5c037). This gates the ARTIFACT, not
# the checkout: the rosary-9c0e6c gate it replaces re-exported the whole store
# and `cmp`'d it against the WORKING-TREE file, which on the branch that wrote
# had just been refreshed (a tautology — a stale pushed commit passed), and on
# any other branch differed by construction (pushes refused for beads written
# elsewhere, "fixed" by a broadening sync commit that swept them in).
#
# `bead verify-pushed` reads git's pre-push stdin (`<local ref> <local sha>
# <remote ref> <remote sha>` per ref): for every `[<repo>-<hex>]` in the
# SUBJECTS of the commits being pushed, `<local sha>:.beads/beads.jsonl` must
# hold the store's exact rendering of that bead. A push whose subjects name no
# bead is never refused, whatever the store holds.
#
# OPT-IN PER PUSHED TIP + SQLite-only: a tip that does not carry
# `.beads/beads.jsonl` never asked for this, whatever branch the push runs
# from (the primitive checks each pushed sha, not this checkout's index).
# Dolt-backed repos push their own store directly (`dolt push`, see
# post-push); an ambiguous dolt/+beads.db store fails closed.
# No shell-side backend guard: the primitive classifies the store itself and
# an ambiguous dolt/+beads.db layout FAILS CLOSED instead of being skipped.

    # ---- GUARD: canonical checkout only (mirrors pre-commit's rosary-599778 guard) ----
    # A linked worktree never receives `.beads/beads.db` (gitignored) but
    # `SqliteBeadStore::connect` creates an empty one on demand — checking
    # against that would report every named bead as "missing" and block a
    # push whose records are perfectly current in the real store.
    _gd=$(git rev-parse --git-dir 2>/dev/null)
    _gc=$(git rev-parse --git-common-dir 2>/dev/null)
    if [ -n "$_gd" ] && [ -n "$_gc" ] && [ "$_gd" != "$_gc" ]; then
        : # Skip only this managed block; continue the surrounding hook.
    else
        RSRY="${RSRY_BIN:-}"
        if [ -z "$RSRY" ]; then
            RSRY=$(command -v rsry 2>/dev/null || true)
        fi
        if [ -z "$RSRY" ] && [ -x "$HOME/.local/bin/rsry" ]; then
            RSRY="$HOME/.local/bin/rsry"
        fi
        if [ -n "$RSRY" ]; then
            # stdin is git's ref list; the primitive consumes it directly and
            # prints the offending ids plus the fix (`rsry bead publish <ids>
            # && git commit --amend --no-edit`) on refusal.
            "$RSRY" bead verify-pushed --remote "$1"
            _rc=$?
            if [ "$_rc" -eq 2 ]; then
                # clap usage error: this rsry predates `bead verify-pushed`
                # (hook newer than binary). The check cannot run, which is
                # not a refusal — warn, like pre-commit's version-drift
                # notice, rather than block every push until the upgrade.
                echo "⚠ rsry at $RSRY cannot run 'bead verify-pushed' — upgrade rsry and re-run rsry hooks install; pre-push gate skipped." >&2
            elif [ "$_rc" -ne 0 ]; then
                echo "ERROR: push refused — the pushed .beads/beads.jsonl is stale for beads" >&2
                echo "  the pushed commits name (see the ids above). Publish them, commit," >&2
                echo "  and push again." >&2
                exit 1
            fi
        fi
    fi
