# === DENY ALL (whitelist approach) ===
# Everything at the root is ignored by default.
# Only explicitly listed items are tracked.
/*

# === RUST BUILD ===
!/Cargo.toml
!/Cargo.lock
!/build.rs
!/clippy.toml
!/src
!/crates
!/tests
!/schemas

# === CONFIG ===
!/.cargo
!/Taskfile.yml
# Included Taskfile modules (`includes:` in Taskfile.yml) — e.g. image build.
!/.taskfiles
!/rosary.toml
!/rosary-self.toml
# Image build — configs tracked, artifacts/keys local-only.
# Active path: `task image:build` / `image:release` use cargo-zigbuild +
# image.Dockerfile (see .taskfiles/image.yml). apko.yaml / melange.yaml are
# retained for reference but deferred — the melange path stalled on Apple
# Silicon (rosary-16df06, precedent ley-line-open-2b255c).
!/apko.yaml
!/melange.yaml
!/image.Dockerfile
# Fresh-setup regression image (vanilla Ubuntu → builds + runs e2e-fresh-setup.sh).
# Active path: `task e2e:fresh`.
!/e2e.Dockerfile
!/entitlements.plist

# === DOCS & DEFINITIONS ===
!/README.md
!/CLAUDE.md
!/AGENTS.md
!/LICENSE
!/docs
!/agents
!/skills
!/scripts

# === TOOLING ===
!/.gitignore
# Points `.beads/beads.jsonl` at the `beads-jsonl` merge driver (rosary-f9516f).
# The whitelist would otherwise silently drop it and the export would fall back
# to git's line-wise text merge.
!/.gitattributes
!/.mcp.json
# MCP capability manifest — importable into a cloister cluster (see server.json).
!/server.json
!/.pre-commit-config.yaml
!/.github
!/.claude-plugin
!/.semgrep
!/.semgrepignore

# === BEADS (tracked config, not data) ===
!/.beads
/.beads/dolt/

# === BEAD STATE ===
!/.rsry-bead-id
!/.rsry-stream.jsonl
.rsry-bead-id
dist/

# proptest failure-persistence artifacts. Only written in PROPTEST_EXPLORE=1
# mode (see src/proptest_support.rs); the deterministic default writes none, so
# a file appearing here means someone ran an exploratory hunt. Commit it
# deliberately if it pins a real counterexample — do not let it drift in.
proptest-regressions/

# cargo-mutants output dirs
mutants.out*/
