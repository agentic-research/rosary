# === DENY ALL (whitelist approach) ===
# Everything at the root is ignored by default.
# Only explicitly listed items are tracked.
/*

# === RUST BUILD ===
!/Cargo.toml
!/Cargo.lock
!/build.rs
!/clippy.toml
!/src
!/crates
!/tests
!/schemas

# === CONFIG ===
!/.cargo
!/Taskfile.yml
!/rosary.toml
!/rosary-self.toml
# Image build — configs tracked, artifacts/keys local-only.
# Active path: `task image` uses krust + image.Dockerfile (see Taskfile.yml).
# apko.yaml / melange.yaml retained for reference but deferred — Apple Silicon
# bind-mount of 31GB target/ made the melange path pathological (rosary-16df06,
# tracked precedent in ley-line-open-2b255c).
!/apko.yaml
!/melange.yaml
!/image.Dockerfile
# Fresh-setup regression image (vanilla Ubuntu → builds + runs e2e-fresh-setup.sh).
# Active path: `task e2e:fresh`.
!/e2e.Dockerfile
!/entitlements.plist

# === DOCS & DEFINITIONS ===
!/README.md
!/CLAUDE.md
!/AGENTS.md
!/LICENSE
!/docs
!/agents
!/skills
!/scripts

# === TOOLING ===
!/.gitignore
!/.mcp.json
!/.pre-commit-config.yaml
!/.github
!/.claude-plugin
!/.semgrep

# === BEADS (tracked config, not data) ===
!/.beads
/.beads/dolt/

# === BEAD STATE ===
!/.rsry-bead-id
!/.rsry-stream.jsonl
.rsry-bead-id
