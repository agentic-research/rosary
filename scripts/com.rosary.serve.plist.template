<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rosary.serve</string>
    <key>ProgramArguments</key>
    <array>
        <string>__RSRY_BIN__</string>
        <string>serve</string>
        <string>--transport</string>
        <string>http</string>
        <string>--port</string>
        <string>8383</string>
    </array>
    <!-- KeepAlive is UNCONDITIONAL, and the distinction cost an outage.
         It was a dict setting SuccessfulExit to false — "restart only
         on a FAILED exit". rsry handles SIGTERM gracefully and exits 0, so
         any clean stop read to launchd as "it did what it was told", and the
         service stayed dead. On 2026-08-28 23:46 it took a SIGTERM, exited
         cleanly, and was simply gone until bead writes started failing in a
         session the next day.
         The old policy could not distinguish an upgrade from any other clean
         stop. install-rsry-service.sh restarts explicitly via `launchctl
         kickstart -k`, which behaves identically under KeepAlive=true, so
         the upgrade path loses nothing.
         CONSEQUENCE: `launchctl stop` no longer stops it — KeepAlive undoes
         that immediately. To stop it deliberately:
             launchctl bootout gui/$(id -u)/com.rosary.serve
         ThrottleInterval below still bounds a crash loop to one restart/5s. -->
    <key>KeepAlive</key>
    <true/>
    <key>ExitTimeOut</key>
    <integer>5</integer>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <!-- No WatchPaths: it didn't reliably fire on the atomic-rename inode
         swap, leaving the service on a stale binary (rosary-de1237). `task
         install` now restarts explicitly via `launchctl kickstart -k`. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>USER</key>
        <string>__USER__</string>
    </dict>
    <key>StandardOutPath</key>
    <string>__RSRY_LOG__</string>
    <key>StandardErrorPath</key>
    <string>__RSRY_LOG__</string>
    <key>RunAtLoad</key>
    <true/>
    <!-- Required for spawned agents to access Keychain (Claude Code OAuth credentials) -->
    <key>SessionCreate</key>
    <true/>
</dict>
</plist>
